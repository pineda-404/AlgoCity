# ---------------------------------------------------------------------------
# AlgoCity · configuración del servidor (copia este archivo como .env)
# Sin configurar nada, la app funciona con los textos predefinidos (canned).
# ---------------------------------------------------------------------------

# Proveedor principal del LLM: remote | local | canned
#   remote → API remota, luego Ollama local, luego textos predefinidos
#   local  → Ollama local, luego textos predefinidos
#   canned → solo textos predefinidos (sin red)
LLM_PROVIDER=canned

# API remota compatible con OpenAI Chat Completions. Ejemplos de LLM_BASE_URL:
#   OpenAI:     https://api.openai.com/v1
#   Groq:       https://api.groq.com/openai/v1
#   Gemini:     https://generativelanguage.googleapis.com/v1beta/openai
#   OpenRouter: https://openrouter.ai/api/v1
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# LLM local con Ollama (https://ollama.com): ollama pull llama3.2
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Si un proveedor no responde en este tiempo, se usa el siguiente (RNF-08)
LLM_TIMEOUT_MS=3000

# Reconocimiento de voz de respaldo (Whisper) para navegadores sin Web Speech API (Firefox).
# Opcional. Cualquier API compatible con /audio/transcriptions de OpenAI.
#   OpenAI: STT_MODEL=whisper-1 · Groq: STT_BASE_URL=https://api.groq.com/openai/v1, STT_MODEL=whisper-large-v3
STT_BASE_URL=https://api.openai.com/v1
STT_API_KEY=
STT_MODEL=whisper-1

PORT=3001
